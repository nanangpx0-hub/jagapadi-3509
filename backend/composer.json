{
    "name": "jagapadi/backend",
    "description": "JAGAPADI Backend - PHP 8.2 Native MVC",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@test",
            "@lint"
        ],
        "lint": "php scripts/lint.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
