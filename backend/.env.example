# =============================================================================
# JAGAPADI Backend Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# PRODUCTION NOTES:
# - APP_ENV=production, APP_DEBUG=false (NEVER true in production)
# - JWT_SECRET: generate with: php -r "echo bin2hex(random_bytes(32));"
# - CORS_ALLOWED_ORIGINS: comma-separated list of allowed origins (HTTPS only in prod)
# - DB_PASS: strong random password
# - APP_BASE_URL: https://domain.tld
# - FCM_ENABLED=true only when Firebase push is ready
# - Login brute-force: LOGIN_MAX_ATTEMPTS=5, LOGIN_DECAY_SECONDS=900
# =============================================================================

# --- Application ---
APP_NAME=JAGAPADI
APP_ENV=local
APP_DEBUG=true
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# --- Database ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jagapadi_local
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- JWT (Mobile Auth) ---
JWT_SECRET=GANTI_DENGAN_SECRET_MINIMAL_64_KARAKTER
JWT_EXPIRY=3600

# --- Web Session ---
SESSION_NAME=jagapadi_session
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900

# --- Logging ---
APP_LOG_LEVEL=debug

# --- CORS ---
# Comma-separated origins allowed to make cross-origin requests.
# In production, list ONLY your web admin and mobile origins (HTTPS).
# Leave empty to use dev defaults (localhost).
CORS_ALLOWED_ORIGINS=

# --- Firebase Cloud Messaging ---
# FCM_ENABLED=true requires FCM_SERVER_KEY to be set.
# google-services.json and *.service_account.json must NOT be committed.
FCM_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=
