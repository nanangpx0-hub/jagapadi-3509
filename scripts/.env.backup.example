# ==============================================================================
# JAGAPADI — Environment Configuration untuk Sinkronisasi Media Rclone
# ==============================================================================
# Salin file ini menjadi 'scripts/.env.backup' untuk menyesuaikan pengaturan lokal:
#   PowerShell: Copy-Item scripts\.env.backup.example scripts\.env.backup
#
# File 'scripts/.env.backup' sudah diabaikan di .gitignore sehingga kredensial lokal
# tidak akan ter-commit ke Git.
# ==============================================================================

# --- Path Executable Rclone ---
# Lokasi binary rclone.exe. Jika kosong, script akan mencari di C:\laragon\bin\rclone.exe
# lalu mencari di variabel PATH sistem.
RCLONE_EXE_PATH=C:\laragon\bin\rclone.exe

# --- File Konfigurasi Rclone ---
# Lokasi file profil rclone. Relative terhadap root proyek JAGAPADI atau path absolut.
RCLONE_CONFIG_PATH=config/rclone.conf

# --- Profil Remote Rclone ---
# Nama profil yang didefinisikan dalam brackets [] pada config/rclone.conf.
# Pilihan: 'cpanel_sftp' (direkomendasikan) atau 'cpanel_ftp'
REMOTE_NAME=cpanel_sftp

# --- Remote Uploads Path (cPanel) ---
# Path direktori uploads di server hosting cPanel.
# Jika SFTP (root /): /home/username_cpanel/public_html/public/uploads
# Jika SFTP (root default): /public_html/public/uploads
# Jika FTP khusus public_html: /public/uploads
REMOTE_UPLOADS_PATH=/home/jagapadi/public_html/public/uploads

# --- Local Uploads Path (Laragon) ---
# Path direktori tujuan lokal. Relative terhadap root proyek JAGAPADI atau path absolut.
LOCAL_UPLOADS_PATH=public/uploads

# --- Mode Sinkronisasi ---
# Pilihan: 'copy' atau 'sync'
# - copy : Hanya mendownload file baru atau yang diperbarui. AMAN: Tidak akan menghapus
#          file lokal meskipun file tersebut sudah dihapus di remote cPanel. (DIREKOMENDASIKAN)
# - sync : Menyamakan persis lokal dengan remote. HATI-HATI: File lokal yang tidak ada
#          di remote cPanel AKAN DIHAPUS permanen!
SYNC_MODE=copy

# --- Bandwidth Throttling ---
# Batas kecepatan download agar tidak mengganggu koneksi kantor/kantor BPS.
# Contoh: 10M (10 Megabytes/detik), 2M, 500k, atau kosong untuk kecepatan penuh.
BANDWIDTH_LIMIT=10M

# --- Logging ---
# Level logging rclone: DEBUG, INFO, NOTICE, ERROR
LOG_LEVEL=INFO
LOG_FILE=storage/logs/rclone_media_sync.log

# --- Optimasi Transfer ---
# Jumlah koneksi transfer paralel (rekomendasi 2-4 untuk shared hosting agar tidak diblokir cPanel)
TRANSFERS=4
# Jumlah thread pengecekan file secara simultan
CHECKERS=8
# Jumlah percobaan ulang jika terjadi putus koneksi sementara
RETRIES=3
