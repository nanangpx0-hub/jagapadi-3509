# =============================================================================
# JAGAPADI .gitignore
# =============================================================================

# --- Secrets ---
.env
.env.local
**/.env
*.pem
*.key
*.crt
*.p12
credentials
*.credentials
*.secret
*.token
google-services.json
**/google-services.json
*.service_account.json
*.jks
key.properties

# --- Backend ---
backend/vendor/
backend/storage/cache/
backend/storage/logs/
backend/public/uploads/
backend/public/assets/uploads/
backend/.phpunit.cache/
!backend/storage/cache/.gitkeep
!backend/storage/logs/.gitkeep
!backend/public/uploads/.gitkeep

# --- Flutter ---
mobile/**/.dart_tool/
mobile/**/build/
mobile/**/.flutter-plugins
mobile/**/.flutter-plugins-dependencies
mobile/**/*.iml
mobile/**/android/.gradle/
mobile/**/android/local.properties
mobile/**/.packages
mobile/**/.pub-cache/
mobile/**/.pub/
mobile/**/pubspec.lock

# --- IDE & Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# --- OS Artifacts ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Build Output ---
dist/
build/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Logs & Cache ---
*.log
.tmp/
tmp/
.cache/

# --- Test Coverage ---
coverage/
.coverage
.pytest_cache/

# --- Docker local overrides ---
docker-compose.override.yml

# --- Backup artifacts ---
backups/

# --- Local scratch & debug artifacts ---
cj.txt
pc.txt
sc.txt
fcm_files.txt
audit_files.txt
tmp_split.txt
backend/cookies_*.txt
backend/headers*.txt
backend/*.html

# --- Local SQL dumps ---
database/jagapadi_local*.sql

# --- Vendor & cache at repo root ---
/vendor/
/storage/cache/

# --- Uploaded assets ---
backend/public/assets/uploads/

# --- Test output artifacts ---
test-results/
e2e/junit.xml
e2e/test-output.json
e2e/*.png

# --- Separate Next.js apps (not part of main repo) ---
/nextjs-app/
/web-app/

# --- Keep these ---
!.gitignore
!.gitkeep
!.editorconfig
!.env.example
!.env.example.*
!.github/
!.github/**
!docs/
!docs/**
!dok/
!dok/**
!scripts/
!scripts/**