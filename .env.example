# ==================================
# JAGAPADI Environment Configuration
# ==================================
# Copy file ini ke .env dan sesuaikan nilainya

# Database Configuration
DB_HOST=localhost
DB_NAME=jagapadi
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/jagapadi

# ==================================
# CURAH HUJAN SCRAPER SETTINGS
# ==================================

# API Key untuk autentikasi scraper (JANGAN SHARE!)
# Generate baru dengan: php -r "echo bin2hex(random_bytes(32));"
SCRAPER_API_KEY=your_api_key_here

# Backup API Key untuk rotasi (opsional)
SCRAPER_API_KEY_BACKUP=

# IP yang diizinkan untuk scraper (pisahkan dengan koma, kosong = allow all)
SCRAPER_ALLOWED_IPS=127.0.0.1

# ==================================
# NOTIFICATION SETTINGS
# ==================================

# Email admin untuk notifikasi alert
ADMIN_EMAIL=admin@jagapadi.local
